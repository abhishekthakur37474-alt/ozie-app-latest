Options -Indexes
DirectoryIndex index.php

# Keep Authorization header (cPanel/FastCGI strips it otherwise)
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Everything that is not a real file -> router
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]
# Disable ModSecurity rules that block POST/JSON requests
# Never serve config directly
<Files "config.php">
    Require all denied
</Files>
